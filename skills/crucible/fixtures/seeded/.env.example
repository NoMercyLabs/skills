# Copy to .env and adjust for the host. The deploy script loads .env before
# it starts the service and the worker.
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_PATH=/var/lib/taskboard/tasks.sqlite3
UPLOAD_DIR=/var/lib/taskboard/uploads
SCRATCH_DIR=/var/lib/taskboard/scratch
ALLOWED_ORIGINS=https://tasks.example.com
TOKEN_SECRET=replace-with-a-long-random-string
TOKEN_TTL_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
MAX_UPLOAD_BYTES=5242880
